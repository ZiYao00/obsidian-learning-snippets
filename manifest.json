{
  "schema_version": 1,
  "repository": "https://github.com/ZiYao00/obsidian-learning-snippets",
  "core": {
    "name": "learning-lab",
    "path": "snippets/learning-lab.css",
    "version": "0.3",
    "cssclasses": ["learning-page"],
    "tokens": ["--ll-*"]
  },
  "extensions": [
    {
      "name": "video-note",
      "path": "snippets/video-note.css",
      "version": "0.2",
      "requires": ["learning-lab>=0.3"],
      "cssclasses": ["learning-page", "video-note"],
      "namespace": ["--vn-*", "video-note-*"]
    },
    {
      "name": "github-note",
      "path": "snippets/github-note.css",
      "version": "0.1",
      "requires": ["learning-lab>=0.3"],
      "cssclasses": ["learning-page", "github-note"],
      "namespace": ["--gn-*", "github-note-*"]
    }
  ]
}
